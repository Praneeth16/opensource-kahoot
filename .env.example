# Written to .env.local by `neon deploy` (first run) or `neon env pull`. Leave these empty here.
# DATABASE_URL: pooled Postgres connection string of the linked Neon branch.
DATABASE_URL=
# NEON_AUTH_BASE_URL: Managed Better Auth endpoint (https://...neonauth.../neondb/auth).
NEON_AUTH_BASE_URL=
# Also written by the pull. This app doesn't use it (it checks sessions with cookies, not JWTs).
NEON_AUTH_JWKS_URL=
# NEON_REALTIME_URL: wss:// endpoint for live queries. NEON_REALTIME_SECRET seals them (server only).
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# NOT written by the pull. Append it yourself, 32+ characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
